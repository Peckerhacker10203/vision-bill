# Copy this file to .env.scripts. Make loads it before running supported tools
# in scripts/. Keep .env.scripts local: it may eventually contain credentials.

# Vision Bill API used by scripts/create_benchmark_run.py and by
# scripts/context_budget.py when it reads the current tag vocabulary.
VB_API_URL=http://127.0.0.1:8080
VB_APP_URL=http://127.0.0.1:8080
# API benchmarks require an admin and current explicitly human-qualified Gold. Keep
# credentials only in the ignored .env.scripts file, not command history.
# VB_USERNAME=admin
# VB_PASSWORD=

# Local Ollama API. Receipt data must not be sent to a remote host.
OLLAMA_HOST=http://127.0.0.1:11434
# For managed native OCR, use the application's same dedicated Ollama endpoint,
# OCR settings and underlying lock file (host spelling of the Compose bind mount):
# LLM__HOST=http://127.0.0.1:11434
# OCR__ENABLED=true
# OCR__SERVICE_URL=http://your-explicitly-exposed-local-sidecar:8082
# OCR__COORDINATION_PATH=/absolute/path/to/vision-bill/server_data/config/gpu-handoff.lock
# Preserve endpoint spelling across processes: journal identity binds LLM__HOST.

# Optional PostgreSQL overrides for context_budget.py --db-sample.
# Base Compose publishes no host DB port. Set an explicitly reachable endpoint;
# 5432 below is illustrative, not an automatic port mapping.
PG__USER=vision_bill
PG__PASSWORD=vision_bill
PG__DB=vision_bill
PG__HOST=127.0.0.1
PG__PORT=5432

# Owner/migration connection used only by `make db-configure-roles`. Keep the
# password in .env.scripts, never in this tracked example.
# MIGRATION_DATABASE_URL=postgresql://migration_owner@127.0.0.1:5432/vision_bill
# Bootstrap missing privilege groups as admin/CREATEROLE, then run grants as owner.
# Alembic uses PG__*; this URL is not an entrypoint migration credential override.
# Standalone benchmark additionally requires --user-id for one real owner and
# SELECT-only credentials. context_budget --db-sample only reads existing images.
